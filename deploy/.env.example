# Sao chép file này thành ".env" (cùng thư mục) rồi điền giá trị thật.
# File ".env" nằm trong .gitignore: không bao giờ commit nó.

# Tên miền trỏ về IP máy chủ, không có "https://". Ví dụ: fuelcast.duckdns.org
DOMAIN=

# Mật khẩu DB. Tạo chuỗi ngẫu nhiên dài, ví dụ:  openssl rand -base64 24
# Chỉ có tác dụng lúc DB được tạo lần đầu. Đổi sau đó phải đổi cả trong DB (ALTER USER),
# đổi mỗi file này là ứng dụng không kết nối được nữa.
POSTGRES_PASSWORD=

# Mật khẩu đăng nhập Grafana (tài khoản "admin"). Grafana mặc định dùng admin/admin nên bắt buộc
# đặt một mật khẩu thật. Grafana chỉ nghe ở 127.0.0.1 của máy chủ (xem docs/observability.md).
GRAFANA_ADMIN_PASSWORD=
